---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ValueCard from '../components/ValueCard.astro';
import CompanyCard from '../components/CompanyCard.astro';
import CTASection from '../components/CTASection.astro';

const metrics = [
  { number: '120+', text: 'Major Companies' },
  { number: '$250B+', text: 'Combined Revenue' },
  { number: '5.2M', text: 'Barrels Per Day' },
  { number: '98%', text: 'Data Accuracy' },
];

const valueProps = [
  {
    icon: '⭐',
    title: 'Verified Excellence',
    description: 'Every company profile is thoroughly verified and updated with the highest standards of accuracy and reliability.',
  },
  {
    icon: '🔒',
    title: 'Comprehensive Data',
    description: 'Access complete financial metrics, production volumes, reserves data, and strategic insights across all major operators.',
  },
  {
    icon: '⏱️',
    title: 'Real-Time Updates',
    description: 'Stay informed with continuously updated operational data, market positions, and industry developments.',
  },
  {
    icon: '📈',
    title: 'Professional Tools',
    description: 'Utilize advanced filtering, comparison capabilities, and data export functions designed for serious analysts.',
  },
];

const companies = [
  {
    rank: '01',
    name: 'ARC Resources Ltd.',
    type: 'Montney Producer',
    stats: [
      { label: 'Daily Production', value: '~410,000 BOE/D' },
      { label: 'Stock Symbol', value: 'ARX (TSX)' },
      { label: 'Land Holdings', value: '1M+ net acres' },
    ],
    slug: 'arc-resources',
  },
  {
    rank: '02',
    name: 'Canadian Natural Resources Limited',
    type: 'Integrated Producer',
    stats: [
      { label: 'Operations', value: 'Canada, UK North Sea, Africa' },
      { label: 'Stock Symbol', value: 'CNQ (TSX/NYSE)' },
      { label: 'Focus', value: 'Oil Sands & Conventional' },
    ],
    slug: 'canadian-natural-resources',
  },
  {
    rank: '03',
    name: 'Cenovus Energy Inc.',
    type: 'Integrated Energy',
    stats: [
      { label: 'Operations', value: 'Canada, US, Asia Pacific' },
      { label: 'Stock Symbol', value: 'CVE (TSX/NYSE)' },
      { label: 'Focus', value: 'Oil Sands & Refining' },
    ],
    slug: 'cenovus-energy',
  },
  {
    rank: '04',
    name: 'Suncor Energy Inc.',
    type: 'Integrated Energy',
    stats: [
      { label: 'Operations', value: 'Oil Sands, Refining, Retail' },
      { label: 'Stock Symbol', value: 'SU (TSX)' },
      { label: 'Focus', value: 'Diverse Energy Sources' },
    ],
    slug: 'suncor-energy',
  },
];
---

<BaseLayout
  title="Canadian Oil Companies | Corporate Directory"
  description="Comprehensive directory of Canada's largest oil companies - Professional resource for energy analysts."
>
  <Hero
    badge="Trusted Industry Resource"
    title="The Definitive Directory of Canada's Oil & Energy Leaders"
    subtitle="Authoritative intelligence and comprehensive profiles for Canadian and international energy analysts"
    primaryCTA="Access Directory"
    secondaryCTA="Request Information"
    metrics={metrics}
  />

  <section class="px-8 py-24 bg-white">
    <div class="max-w-[1400px] mx-auto">
      <SectionHeader
        label="Why Choose Us"
        title="The Industry Standard for Energy Intelligence"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
        {valueProps.map(prop => (
          <ValueCard
            icon={prop.icon}
            title={prop.title}
            description={prop.description}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="px-8 py-24 bg-off-white">
    <div class="max-w-[1400px] mx-auto">
      <SectionHeader
        label="Industry Leaders"
        title="Featured Canadian Energy Companies"
        subtitle="Profiles of Canada's most significant oil and gas producers"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        {companies.map(company => (
          <CompanyCard
            rank={company.rank}
            name={company.name}
            type={company.type}
            stats={company.stats}
          />
        ))}
      </div>

      <div class="text-center">
        <button class="bg-transparent text-deep-navy border-2 border-deep-navy px-10 py-4 text-base font-semibold rounded-md cursor-pointer transition-all duration-300 hover:bg-deep-navy hover:text-white hover:-translate-y-0.5">
          View Complete Directory
        </button>
      </div>
    </div>
  </section>

  <CTASection
    label="Get Started Today"
    title="Join Leading Energy Analysts Worldwide"
    description="Access the most comprehensive and trusted directory of Canadian oil companies. Trusted by analysts, investors, and industry professionals across the globe."
    primaryButton="Access Full Directory"
    secondaryButton="Schedule a Demo"
  />
</BaseLayout>
