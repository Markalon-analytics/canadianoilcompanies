---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTASection from '../components/CTASection.astro';

const teamValues = [
  {
    title: 'Accuracy',
    description: 'We maintain the highest standards of data accuracy and reliability.',
  },
  {
    title: 'Transparency',
    description: 'Clear sources and methodologies for all our data and analysis.',
  },
  {
    title: 'Innovation',
    description: 'Continuously improving our platform with new features and capabilities.',
  },
  {
    title: 'Service',
    description: 'Dedicated to providing exceptional support to our clients.',
  },
];
---

<BaseLayout
  title="About | Canadian Oil Companies Directory"
  description="Learn about our mission to provide the most comprehensive and trusted directory of Canadian oil companies."
>
  <Hero
    badge="About Us"
    title="Empowering Energy Professionals with Trusted Intelligence"
  />

  <section class="px-8 py-24 bg-white">
    <div class="max-w-[1000px] mx-auto">
      <SectionHeader
        label="Our Mission"
        title="Comprehensive Energy Intelligence at Your Fingertips"
      />

      <div class="prose prose-lg max-w-none text-charcoal">
        <p class="text-lg leading-relaxed mb-6">
          Canadian Oil Companies Directory is a comprehensive resource from Geologic, designed to provide energy professionals with authoritative intelligence on Canada's oil and gas sector. Our database covers the entire Canadian energy landscape, from major integrated producers to independent operators.
        </p>

        <p class="text-lg leading-relaxed mb-6">
          We understand that accurate, timely information is critical for making informed decisions in the energy sector. This resource brings together comprehensive data on Canada's major oil and gas companies in one accessible platform.
        </p>

        <p class="text-lg leading-relaxed">
          Whether you're an analyst, investor, or industry professional, this resource is designed to help you quickly access the intelligence you need about Canada's energy sector.
        </p>
      </div>
    </div>
  </section>

  <section class="px-8 py-24 bg-off-white">
    <div class="max-w-[1400px] mx-auto">
      <SectionHeader
        label="Our Values"
        title="What Drives Us"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {teamValues.map(value => (
          <div class="bg-white p-8 rounded-lg shadow-sm border-t-4 border-petroleum-gold">
            <h3 class="text-xl font-bold text-deep-navy mb-3">{value.title}</h3>
            <p class="text-charcoal">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection isGeologicCTA={true} />
</BaseLayout>
