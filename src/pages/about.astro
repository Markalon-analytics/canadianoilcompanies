---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTASection from '../components/CTASection.astro';

const teamValues = [
  {
    title: 'Accuracy',
    description: 'We maintain the highest standards of data accuracy and reliability.',
  },
  {
    title: 'Transparency',
    description: 'Clear sources and methodologies for all our data and analysis.',
  },
  {
    title: 'Innovation',
    description: 'Continuously improving our platform with new features and capabilities.',
  },
  {
    title: 'Service',
    description: 'Dedicated to providing exceptional support to our clients.',
  },
];
---

<BaseLayout
  title="About | Canadian Oil Companies Directory"
  description="Learn about our mission to provide the most comprehensive and trusted directory of Canadian oil companies."
>
  <Hero
    badge="About Us"
    title="The Authority on Canadian Energy Intelligence"
    subtitle="Providing trusted data and insights to energy professionals since 2005"
  />

  <section class="px-8 py-24 bg-white">
    <div class="max-w-[1000px] mx-auto">
      <SectionHeader
        label="Our Mission"
        title="Empowering Energy Professionals with Trusted Intelligence"
      />

      <div class="prose prose-lg max-w-none text-charcoal">
        <p class="text-lg leading-relaxed mb-6">
          Canadian Oil Companies Directory has been the premier source of energy intelligence for analysts,
          investors, and industry professionals for over 18 years. Our comprehensive database covers the
          entire Canadian energy sector, from major integrated producers to independent operators.
        </p>

        <p class="text-lg leading-relaxed mb-6">
          We understand that accurate, timely information is critical for making informed decisions in the
          energy sector. That's why we've built a platform that combines comprehensive data coverage with
          rigorous verification processes and continuous updates.
        </p>

        <p class="text-lg leading-relaxed">
          Our team of industry experts and data specialists work around the clock to ensure our platform
          provides the most reliable and actionable intelligence available.
        </p>
      </div>
    </div>
  </section>

  <section class="px-8 py-24 bg-off-white">
    <div class="max-w-[1400px] mx-auto">
      <SectionHeader
        label="Our Values"
        title="What Drives Us"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {teamValues.map(value => (
          <div class="bg-white p-8 rounded-lg shadow-sm border-t-4 border-petroleum-gold">
            <h3 class="text-xl font-bold text-deep-navy mb-3">{value.title}</h3>
            <p class="text-charcoal">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="px-8 py-24 bg-white">
    <div class="max-w-[1000px] mx-auto text-center">
      <SectionHeader
        label="By the Numbers"
        title="Our Impact"
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="bg-off-white p-8 rounded-lg">
          <div class="text-5xl font-bold text-petroleum-gold mb-2">18+</div>
          <div class="text-charcoal">Years of Service</div>
        </div>

        <div class="bg-off-white p-8 rounded-lg">
          <div class="text-5xl font-bold text-petroleum-gold mb-2">5,000+</div>
          <div class="text-charcoal">Active Users</div>
        </div>

        <div class="bg-off-white p-8 rounded-lg">
          <div class="text-5xl font-bold text-petroleum-gold mb-2">50+</div>
          <div class="text-charcoal">Countries Served</div>
        </div>

        <div class="bg-off-white p-8 rounded-lg">
          <div class="text-5xl font-bold text-petroleum-gold mb-2">99.9%</div>
          <div class="text-charcoal">Uptime</div>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    label="Join Us"
    title="Become Part of Our Community"
    description="Join thousands of energy professionals who trust our platform for critical industry intelligence."
    primaryButton="Get Started Today"
    primaryButtonHref="https://info.evaluateenergy.com/"
    secondaryButton="Contact Us"
    secondaryButtonHref="https://info.evaluateenergy.com/"
  />
</BaseLayout>
