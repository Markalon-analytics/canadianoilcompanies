---
interface Props {
  rank: string;
  name: string;
  type: string;
  stats: Array<{
    label: string;
    value: string;
  }>;
}

const { rank, name, type, stats } = Astro.props;
---

<article class="bg-white rounded-lg p-8 shadow-sm border-l-4 border-petroleum-gold transition-all duration-300 hover:-translate-y-1.5 hover:shadow-md hover:border-rich-amber">
  <div class="flex items-start gap-6 mb-6 pb-6 border-b border-off-white">
    <div class="text-[2rem] font-extrabold text-petroleum-gold font-serif leading-none">
      {rank}
    </div>
    <div>
      <h3 class="text-[1.3rem] font-bold text-deep-navy mb-1.5">
        {name}
      </h3>
      <p class="text-[0.85rem] text-petroleum-gold font-semibold uppercase tracking-wide">
        {type}
      </p>
    </div>
  </div>

  <div class="flex flex-col gap-4">
    {stats.map(stat => (
      <div class="flex justify-between items-center text-[0.9rem]">
        <span class="text-charcoal font-medium">{stat.label}</span>
        <span class="text-deep-navy font-bold">{stat.value}</span>
      </div>
    ))}
  </div>
</article>
