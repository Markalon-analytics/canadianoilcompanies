---
const currentYear = new Date().getFullYear();
---

<footer class="bg-deep-navy px-8 py-16 text-white">
  <div class="max-w-[1400px] mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-12 justify-items-center text-left">
      <div class="max-w-[350px]">
        <div class="flex items-center gap-3 mb-5">
          <span class="text-[1.5rem] text-petroleum-gold">◆</span>
          <span class="text-xl font-bold font-serif">Canadian Oil Companies</span>
        </div>
        <p class="text-[0.9rem] leading-relaxed text-white/80">
          The authoritative directory and intelligence platform for Canada's energy sector, serving analysts and professionals worldwide.
        </p>
      </div>

      <div>
        <h4 class="text-base font-bold mb-5 text-petroleum-gold font-serif">Company</h4>
        <a href="#" class="block text-white/80 no-underline mb-3 text-[0.9rem] hover:text-petroleum-gold transition-colors duration-300">About Us</a>
        <a href="#" class="block text-white/80 no-underline mb-3 text-[0.9rem] hover:text-petroleum-gold transition-colors duration-300">Contact</a>
      </div>

      <div>
        <h4 class="text-base font-bold mb-5 text-petroleum-gold font-serif">Legal</h4>
        <a href="#" class="block text-white/80 no-underline mb-3 text-[0.9rem] hover:text-petroleum-gold transition-colors duration-300">Privacy Policy</a>
        <a href="#" class="block text-white/80 no-underline mb-3 text-[0.9rem] hover:text-petroleum-gold transition-colors duration-300">Terms of Service</a>
      </div>
    </div>

    <div class="h-[1px] bg-gradient-to-r from-transparent via-petroleum-gold to-transparent my-8"></div>

    <div class="flex justify-center items-center text-center">
      <p class="text-[0.85rem] text-white/70">&copy; {currentYear} Canadian Oil Companies Directory. All rights reserved.</p>
    </div>
  </div>
</footer>
