---
interface Props {
    totalCount: number;
}

const { totalCount } = Astro.props;
---

<div class="directory-filters">
    <div class="filters-top">
        <div class="search-wrapper">
            <svg
                class="search-icon"
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
                type="search"
                id="company-search"
                placeholder="Search by company name, description, or location..."
                autocomplete="off"
            />
            <button
                type="button"
                id="clear-search"
                class="clear-btn hidden"
                aria-label="Clear search"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M18 6 6 18"></path>
                    <path d="m6 6 12 12"></path>
                </svg>
            </button>
        </div>
    </div>

    <div class="filters-bottom">
        <div
            class="filter-tabs"
            role="tablist"
            aria-label="Filter companies by category"
        >
            <button
                type="button"
                data-category="all"
                class="filter-tab active"
                role="tab"
                aria-selected="true"
            >
                <span class="tab-icon">📊</span>
                <span class="tab-text">All Companies</span>
                <span class="tab-count" id="count-all">{totalCount}</span>
            </button>
            <button
                type="button"
                data-category="producer"
                class="filter-tab"
                role="tab"
                aria-selected="false"
            >
                <span class="tab-icon">🛢️</span>
                <span class="tab-text">Oil & Gas Producers</span>
                <span class="tab-count" id="count-producer">0</span>
            </button>
            <button
                type="button"
                data-category="midstream"
                class="filter-tab"
                role="tab"
                aria-selected="false"
            >
                <span class="tab-icon">🔧</span>
                <span class="tab-text">Midstream</span>
                <span class="tab-count" id="count-midstream">0</span>
            </button>
            <button
                type="button"
                data-category="services"
                class="filter-tab"
                role="tab"
                aria-selected="false"
            >
                <span class="tab-icon">⚙️</span>
                <span class="tab-text">Services</span>
                <span class="tab-count" id="count-services">0</span>
            </button>
        </div>

        <div class="results-info">
            <span id="results-count">Showing {totalCount} companies</span>
        </div>
    </div>
</div>

<style>
    .directory-filters {
        background: white;
        padding: 1.5rem 2rem;
        border-radius: 0.75rem;
        box-shadow: 0 4px 20px rgba(10, 38, 71, 0.08);
        margin-bottom: 2rem;
        border: 1px solid rgba(10, 38, 71, 0.06);
    }

    .filters-top {
        margin-bottom: 1.25rem;
    }

    .search-wrapper {
        position: relative;
        max-width: 500px;
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #9ca3af;
        pointer-events: none;
    }

    #company-search {
        width: 100%;
        padding: 0.875rem 2.75rem 0.875rem 2.75rem;
        border: 2px solid #e5e7eb;
        border-radius: 0.5rem;
        font-size: 1rem;
        font-family: inherit;
        transition: all 0.2s ease;
        background: #f9fafb;
    }

    #company-search:focus {
        outline: none;
        border-color: #d4a846;
        background: white;
        box-shadow: 0 0 0 3px rgba(212, 168, 70, 0.15);
    }

    #company-search::placeholder {
        color: #9ca3af;
    }

    .clear-btn {
        position: absolute;
        right: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.25rem;
        color: #9ca3af;
        border-radius: 0.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s;
    }

    .clear-btn:hover {
        color: #0a2647;
    }

    .clear-btn.hidden {
        display: none;
    }

    .filters-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .filter-tabs {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .filter-tab {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1rem;
        border: 2px solid #e5e7eb;
        background: white;
        color: #4b5563;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 600;
        font-family: inherit;
        transition: all 0.2s ease;
    }

    .filter-tab:hover {
        border-color: #0a2647;
        color: #0a2647;
    }

    .filter-tab.active {
        background: #0a2647;
        border-color: #0a2647;
        color: white;
    }

    .tab-icon {
        font-size: 1rem;
    }

    .tab-count {
        background: rgba(0, 0, 0, 0.1);
        padding: 0.125rem 0.5rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .filter-tab.active .tab-count {
        background: rgba(255, 255, 255, 0.2);
    }

    .results-info {
        font-size: 0.875rem;
        color: #6b7280;
        font-weight: 500;
    }

    @media (max-width: 768px) {
        .directory-filters {
            padding: 1rem 1.25rem;
        }

        .search-wrapper {
            max-width: 100%;
        }

        .filter-tabs {
            width: 100%;
            justify-content: center;
        }

        .filter-tab {
            flex: 1;
            min-width: calc(50% - 0.25rem);
            justify-content: center;
            padding: 0.5rem 0.75rem;
        }

        .tab-text {
            display: none;
        }

        .results-info {
            width: 100%;
            text-align: center;
        }
    }
</style>
