    // Category buttons
    const allCompaniesBtn = document.getElementById('allCompaniesBtn');
    const integratedProducersBtn = document.getElementById('integratedProducersBtn');
    const independentOperatorsBtn = document.getElementById('independentOperatorsBtn');
    const naturalGasFocusedBtn = document.getElementById('naturalGasFocusedBtn');
    const midstreamBtn = document.getElementById('midstreamBtn');
    const serviceCompaniesBtn = document.getElementById('serviceCompaniesBtn');
    
    // Alphabet filter
    const alphabetFilter = document.getElementById('alphabetFilter');
    const alphabetBtns = document.querySelectorAll('.alphabet-btn');
    
    // Grid container
    const gridContainer = document.querySelector('.grid');
    
    let currentCategory: string = 'all';
    let currentLetter: string = 'all';

    // Category button handlers
    allCompaniesBtn?.addEventListener('click', () => {
      setActiveCategory('all');
      if (alphabetFilter) alphabetFilter.style.display = 'flex';
      filterCompanies();
    });

    integratedProducersBtn?.addEventListener('click', () => {
      setActiveCategory('integrated');
      if (alphabetFilter) alphabetFilter.style.display = 'flex';
      filterCompanies();
    });

    independentOperatorsBtn?.addEventListener('click', () => {
      setActiveCategory('independent');
      if (alphabetFilter) alphabetFilter.style.display = 'flex';
      filterCompanies();
    });

    naturalGasFocusedBtn?.addEventListener('click', () => {
      setActiveCategory('gas');
      if (alphabetFilter) alphabetFilter.style.display = 'flex';
      filterCompanies();
    });

    midstreamBtn?.addEventListener('click', () => {
      setActiveCategory('midstream');
      if (alphabetFilter) alphabetFilter.style.display = 'flex';
      filterCompanies();
    });

    serviceCompaniesBtn?.addEventListener('click', () => {
      setActiveCategory('service');
      if (alphabetFilter) alphabetFilter.style.display = 'flex';
      filterCompanies();
    });

    // Alphabet button handlers
    alphabetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const letter = (btn as HTMLElement).dataset?.letter || 'all';
        currentLetter = letter;
        setActiveAlphabet(currentLetter);
        filterCompanies();
      });
    });

    function setActiveCategory(category: string): void {
      currentCategory = category;
      
      // Reset all category buttons
      [allCompaniesBtn, integratedProducersBtn, independentOperatorsBtn, naturalGasFocusedBtn].forEach(btn => {
        if (btn) {
          btn.classList.remove('bg-petroleum-gold', 'text-white');
          btn.classList.add('bg-white', 'text-charcoal', 'border-2', 'border-gray-300');
        }
      });
      
      // Set active button
      if (category === 'all' && allCompaniesBtn) {
        allCompaniesBtn.classList.remove('bg-white', 'text-charcoal', 'border-2', 'border-gray-300');
        allCompaniesBtn.classList.add('bg-petroleum-gold', 'text-white');
      } else if (category === 'integrated' && integratedProducersBtn) {
        integratedProducersBtn.classList.remove('bg-white', 'text-charcoal', 'border-2', 'border-gray-300');
        integratedProducersBtn.classList.add('bg-petroleum-gold', 'text-white');
      } else if (category === 'independent' && independentOperatorsBtn) {
        independentOperatorsBtn.classList.remove('bg-white', 'text-charcoal', 'border-2', 'border-gray-300');
        independentOperatorsBtn.classList.add('bg-petroleum-gold', 'text-white');
      } else if (category === 'gas' && naturalGasFocusedBtn) {
        naturalGasFocusedBtn.classList.remove('bg-white', 'text-charcoal', 'border-2', 'border-gray-300');
        naturalGasFocusedBtn.classList.add('bg-petroleum-gold', 'text-white');
      } else if (category === 'midstream' && midstreamBtn) {
        midstreamBtn.classList.remove('bg-white', 'text-charcoal', 'border-2', 'border-gray-300');
        midstreamBtn.classList.add('bg-petroleum-gold', 'text-white');
      } else if (category === 'service' && serviceCompaniesBtn) {
        serviceCompaniesBtn.classList.remove('bg-white', 'text-charcoal', 'border-2', 'border-gray-300');
        serviceCompaniesBtn.classList.add('bg-petroleum-gold', 'text-white');
      }
    }

    function setActiveAlphabet(letter: string): void {
      // Reset all alphabet buttons
      alphabetBtns.forEach(btn => {
        btn.classList.remove('bg-petroleum-gold', 'text-white');
        btn.classList.add('bg-white', 'text-charcoal', 'border-2', 'border-gray-300');
      });
      
      // Set active button
      const activeBtn = document.querySelector(`[data-letter="${letter}"]`) as HTMLElement;
      if (activeBtn) {
        activeBtn.classList.remove('bg-white', 'text-charcoal', 'border-2', 'border-gray-300');
        activeBtn.classList.add('bg-petroleum-gold', 'text-white');
      }
    }

    function filterCompanies(): void {
      let filteredCompanies = [...allCompanies];
      
      // Apply category filter
      if (currentCategory === 'integrated') {
        filteredCompanies = filteredCompanies.filter(c => 
          c.type.includes('Integrated') || c.type.includes('Producer') || c.type.includes('Montney')
        );
      } else if (currentCategory === 'independent') {
        filteredCompanies = filteredCompanies.filter(c => 
          c.type.includes('Independent') || c.type.includes('Exploration') || c.type.includes('Mining')
        );
      } else if (currentCategory === 'gas') {
        filteredCompanies = filteredCompanies.filter(c => 
          c.type.includes('Gas') || c.type.includes('Natural') || c.type.includes('Helium')
        );
      } else if (currentCategory === 'midstream') {
        filteredCompanies = filteredCompanies.filter(c => 
          c.type === 'Midstream Company'
        );
      } else if (currentCategory === 'service') {
        filteredCompanies = filteredCompanies.filter(c => 
          c.type === 'Service Company'
        );
      }
      
      // Apply alphabet filter
      if (currentLetter !== 'all') {
        filteredCompanies = filteredCompanies.filter(c => 
          c.name.toUpperCase().startsWith(currentLetter)
        );
      }
      
      // Render filtered companies
      renderCompanies(filteredCompanies);
    }

    function renderCompanies(companies: any[]): void {
      if (gridContainer) {
        gridContainer.innerHTML = companies.map((company: any) => `
          <a href="/companies/${company.slug}/" class="no-underline">
            <div class="bg-white rounded-lg shadow-md border-t-4 border-petroleum-gold p-8 transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
              <div class="flex items-start justify-between mb-4">
                <span class="text-petroleum-gold text-2xl font-bold">${company.rank}</span>
                <span class="bg-light-gold text-deep-navy px-3 py-1 rounded-full text-sm font-semibold">
                  ${company.type}
                </span>
              </div>
              <h3 class="text-xl font-bold text-deep-navy mb-3">${company.name}</h3>
              <div class="space-y-2">
                ${company.stats.map((stat: any) => `
                  <div class="flex justify-between items-center">
                    <span class="text-charcoal text-sm">${stat.label}:</span>
                    <span class="text-deep-navy font-semibold text-sm">${stat.value}</span>
                  </div>
                `).join('')}
              </div>
            </div>
          </a>
        `).join('');
        
        // Update count
        const countElement = document.querySelector('.inline-flex.items-center.gap-3 span.text-deep-navy');
        if (countElement) {
          countElement.textContent = `Showing ${companies.length} of ${allCompanies.length} companies`;
        }
      }
    }

    // Alphabet filter event listeners
    alphabetBtns.forEach(btn => {
      const letter = btn.getAttribute('data-letter');
      if (letter) {
        btn.addEventListener('click', () => {
          currentLetter = letter;
          setActiveAlphabet(letter);
          filterCompanies();
        });
      }
    });

    // Initialize
    filterCompanies();
  </script>
</BaseLayout>
